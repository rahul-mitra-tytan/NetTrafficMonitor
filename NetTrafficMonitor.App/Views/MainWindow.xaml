<Window x:Class="NetTrafficMonitor.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:NetTrafficMonitor.ViewModels" xmlns:conv="clr-namespace:NetTrafficMonitor.Converters" Title="NetTrafficMonitor Settings" Width="660" Height="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13"> <Window.Resources> <conv:SpeedUnitToStringConverter x:Key="SpeedUnitToStr"/> <conv:DataPeriodToStringConverter x:Key="PeriodToStr"/> </Window.Resources> <Grid Margin="15"> <TabControl> <!-- TAB 1: General --> <TabItem Header="General"> <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10"> <StackPanel> <Label Content="Network Adapter" Style="{DynamicResource SectionHeader}"/> <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" Height="30" /> <Button Content="Refresh Adapters" Command="{Binding LoadAdaptersCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,8,0,0"/> <Label Content="Theme" Style="{DynamicResource SectionHeader}"/> <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Height="30" /> <Label Content="Display Unit" Style="{DynamicResource SectionHeader}"/> <ComboBox ItemsSource="{Binding SpeedUnits}" SelectedItem="{Binding SelectedUnit}" Height="30" /> <Label Content="Font" Style="{DynamicResource SectionHeader}"/> <Grid> <Grid.ColumnDefinitions> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/> <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/> </Grid.ColumnDefinitions> <TextBlock Grid.Column="0" Text="Family:" VerticalAlignment="Center" Margin="0,0,8,0"/> <TextBox Grid.Column="1" Text="{Binding FontFamily}" Height="28" /> <TextBlock Grid.Column="2" Text="Size:" VerticalAlignment="Center" Margin="8,0,8,0"/> <TextBox Grid.Column="3" Text="{Binding FontSize}" Height="28" /> </Grid> <Label Content="Behaviour" Style="{DynamicResource SectionHeader}"/> <CheckBox IsChecked="{Binding StartMinimized}" Content="Start minimized to tray" Margin="0,4"/> <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimize to tray instead of taskbar" Margin="0,4"/> <CheckBox IsChecked="{Binding RunOnStartup}" Content="Run on Windows startup" Margin="0,4"/> </StackPanel> </ScrollViewer> </TabItem> <!-- TAB 2: HUD --> <TabItem Header="HUD"> <StackPanel Margin="10"> <Label Content="Heads-Up Display" Style="{DynamicResource SectionHeader}"/> <CheckBox IsChecked="{Binding HudEnabled}" Content="Enable floating HUD window" Margin="0,4"/> <GroupBox Header="Appearance" Margin="0,12,0,0"> <StackPanel> <Grid Margin="0,4"> <Grid.ColumnDefinitions> <ColumnDefinition Width="100"/> <ColumnDefinition Width="*"/> </Grid.ColumnDefinitions> <TextBlock Grid.Column="0" Text="Opacity:" VerticalAlignment="Center"/> <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" SmallChange="0.05" Value="{Binding HudOpacity}" Margin="8,0"/> </Grid> <Grid Margin="0,8,0,0"> <Grid.ColumnDefinitions> <ColumnDefinition Width="100"/> <ColumnDefinition Width="*"/> </Grid.ColumnDefinitions> <TextBlock Grid.Column="0" Text="Font Size:" VerticalAlignment="Center"/> <TextBox Grid.Column="1" Text="{Binding FontSize}" Height="28" /> </Grid> </StackPanel> </GroupBox> <TextBlock Text="Tip: HUD can be made click-through from the tray menu." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0"/> </StackPanel> </TabItem>    <!-- TAB 3: Data Usage -->
    <TabItem Header="Data Usage">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0">
                <Label Content="Usage Summary" Style="{DynamicResource SectionHeader}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate, Mode=TwoWay}" Height="28"/>
                    <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate, Mode=TwoWay}" Height="28"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Unit:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataSizeUnits}" SelectedItem="{Binding SelectedDataSizeUnit}" Height="30"/>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,8">
                <Canvas x:Name="GraphCanvas" SizeChanged="GraphCanvas_SizeChanged" ClipToBounds="True"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PeriodFormattedDownload, StringFormat=Total Download: \{0\}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding PeriodFormattedUpload, StringFormat=Total Upload: \{0\}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OrangeBrush}" HorizontalAlignment="Center"/>
            </Grid>

            <Button Grid.Row="3" Content="Refresh" Command="{Binding RefreshUsageCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </Grid>
    </TabItem> </TabControl> <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0"/> </Grid> </Window>
