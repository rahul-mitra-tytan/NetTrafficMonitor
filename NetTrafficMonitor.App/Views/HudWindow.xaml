<Window x:Class="NetTrafficMonitor.Views.HudWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NetTraffic HUD" Icon="pack://application:,,,/Resources/app.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Window.Resources>
        <ContextMenu x:Key="HudContextMenu" x:Shared="False">
            <ContextMenu.Style>
                <Style TargetType="ContextMenu">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <StackPanel>
                                        <ItemsPresenter/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Style>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="8,4,16,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        <Path x:Name="RightArrow" Grid.Column="1" Visibility="Collapsed" Margin="16,0,0,0" Data="M 0,0 L 4,4 L 0,8 Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-4" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="2">
                                                <ItemsPresenter/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Role" Value="SubmenuHeader">
                                        <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Show Speed" Click="OnSpeedViewClick"/>
            <MenuItem Header="Show Graph" Click="OnGraphViewClick"/>
            <Separator/>
            <MenuItem Header="Units">
                <MenuItem Header="bps (bits/s)" Click="OnUnitClick" Tag="bps"/>
                <MenuItem Header="Kbps (kilobits/s)" Click="OnUnitClick" Tag="Kbps"/>
                <MenuItem Header="Mbps (megabits/s)" Click="OnUnitClick" Tag="Mbps"/>
                <MenuItem Header="Gbps (gigabits/s)" Click="OnUnitClick" Tag="Gbps"/>
                <Separator/>
                <MenuItem Header="B/s (Bytes/s)" Click="OnUnitClick" Tag="Bps"/>
                <MenuItem Header="KB/s (Kilobytes/s)" Click="OnUnitClick" Tag="KBps"/>
                <MenuItem Header="MB/s (Megabytes/s)" Click="OnUnitClick" Tag="MBps"/>
                <MenuItem Header="GB/s (Gigabytes/s)" Click="OnUnitClick" Tag="GBps"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Close" Click="OnCloseClick"/>
        </ContextMenu>
    </Window.Resources>





    <Grid>
        <Border CornerRadius="8" Background="{DynamicResource BgBrush}" Opacity="0.85"/>
        <Border CornerRadius="8" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" Padding="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ClickThrough}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed View -->
                <StackPanel x:Name="SpeedView" Grid.Row="0" Grid.ColumnSpan="2">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Network Speed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="↓" Foreground="{DynamicResource GreenBrush}" FontSize="{Binding HudFontSize}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DownloadText" Text="0 Mb/s" Foreground="{DynamicResource GreenBrush}" FontSize="{Binding HudFontSize}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="↑" Foreground="{DynamicResource OrangeBrush}" FontSize="{Binding HudFontSize}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UploadText" Text="0 Mb/s" Foreground="{DynamicResource OrangeBrush}" FontSize="{Binding HudFontSize}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Graph View (hidden by default) -->
                <Canvas x:Name="GraphView" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Width="250" Height="100" Margin="0,10,0,0">
                    <Path x:Name="DownloadGraph" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2"/>
                    <Path x:Name="UploadGraph" Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
