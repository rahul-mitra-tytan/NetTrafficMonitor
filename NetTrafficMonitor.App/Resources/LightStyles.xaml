<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F2F2F2</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="ControlBgColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D1D1D1</Color>
    <Color x:Key="TextColor">#1E1E1E</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="HoverColor">#E5E5E5</Color>
    <Color x:Key="TabHoverColor">#E5E5E5</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource TabHoverColor}"/>

    <SolidColorBrush x:Key="LightSurfaceBrush" Color="{StaticResource SurfaceColor}"/>
</ResourceDictionary>
